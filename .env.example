TDLIB_SHARED_LIBRARY_PATH=
TDLIB_RUNTIME_MODE=mock
TDLIB_AUTH_JOB_TIMEOUT_SECONDS=300
TDLIB_READONLY_SMOKE_ENABLED=false
PROFILE_EXECUTION_ADAPTER=mock
TDLIB_LIVE_ENABLED=false
ACCOUNT_IMPORT_MAX_FILE_COUNT=200
ACCOUNT_IMPORT_MAX_UNCOMPRESSED_BYTES=52428800
ACCOUNT_IMPORT_MAX_DEPTH=8
ACCOUNT_IMPORT_MAX_UPLOAD_BYTES=52428800
ACCOUNT_EXPORT_TTL_DAYS=7
ACCOUNT_DELETION_LOG_RETENTION_DAYS=90
ACCOUNT_DELETION_ALLOW_HARD_DELETE=false
