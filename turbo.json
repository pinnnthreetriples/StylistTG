{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "generate:api": {
      "cache": false
    },
    "check:api": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "qa:browser": {
      "dependsOn": ["build"],
      "cache": false
    },
    "qa:screenshots": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
