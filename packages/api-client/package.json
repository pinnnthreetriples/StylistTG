{
  "name": "@stylisttg/api-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "generate:openapi": "node ./scripts/export-openapi.mjs --out ./openapi.json",
    "generate:types": "openapi-typescript ./openapi.json -o ./src/generated/schema.d.ts && node ./scripts/mark-generated-schema.mjs",
    "generate:api": "npm run generate:openapi && npm run generate:types",
    "check:api": "node ./scripts/check-openapi-drift.mjs",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
