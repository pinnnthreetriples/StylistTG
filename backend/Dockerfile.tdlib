FROM python:3.12-slim AS tdlib-builder

ARG TDLIB_GIT_REF=8fc2344f3e3daf55983032a44c4156bd8a1a7533
ARG TDLIB_BUILD_PARALLELISM=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        gperf \
        git \
        libssl-dev \
        ninja-build \
        zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

RUN git clone --depth 1 https://github.com/tdlib/td.git td && \
    cd td && \
    git checkout "${TDLIB_GIT_REF}" && \
    cmake -S . -B build -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/tdlib-install \
        -DTD_ENABLE_LTO=OFF && \
    cmake --build build --target tdjson --parallel "${TDLIB_BUILD_PARALLELISM}" && \
    mkdir -p /tdlib-runtime/lib && \
    find build -name 'libtdjson.so*' -exec cp -P {} /tdlib-runtime/lib/ \; && \
    test -e /tdlib-runtime/lib/libtdjson.so

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LOCAL_STORAGE_PATH=/var/lib/stylisttg/storage \
    TDLIB_LIVE_ENABLED=false \
    TDLIB_RUNTIME_MODE=mock \
    PROFILE_EXECUTION_ADAPTER=mock \
    TDLIB_READONLY_SMOKE_ENABLED=false \
    TDLIB_SHARED_LIBRARY_PATH=/usr/local/lib/libtdjson.so \
    TDLIB_DATABASE_ROOT=/var/lib/stylisttg/tdlib/database \
    TDLIB_FILES_ROOT=/var/lib/stylisttg/tdlib/files

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libstdc++6 \
        zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system stylisttg && \
    adduser --system --ingroup stylisttg stylisttg && \
    mkdir -p /var/lib/stylisttg/storage \
        /var/lib/stylisttg/logs \
        /var/lib/stylisttg/tdlib/database \
        /var/lib/stylisttg/tdlib/files \
        /usr/local/lib && \
    chown -R stylisttg:stylisttg /var/lib/stylisttg

COPY --from=tdlib-builder /tdlib-runtime/lib/libtdjson.so* /usr/local/lib/
RUN ldconfig

COPY backend/pyproject.toml backend/alembic.ini ./
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/scripts ./scripts

RUN python -m pip install --upgrade pip && \
    python -m pip install .

USER stylisttg

CMD ["sh", "-c", "python -m app.scripts.tdlib_runtime_smoke --runtime-check --library-check --json && python -m app.workers.run_worker --queues auth_jobs,profile_jobs,media_jobs,story_jobs"]
