{
  "name": "@stylisttg/api-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "generate:openapi": "python ../../backend/app/scripts/export_openapi.py --out ./openapi.json",
    "generate:types": "openapi-typescript ./openapi.json -o ./src/generated/schema.d.ts",
    "generate:api": "npm run generate:openapi && npm run generate:types",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  }
}
