{
  "name": "stylisttg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "coverage": "turbo run coverage",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "generate:api": "turbo run generate:api",
    "check:api": "turbo run check:api",
    "qa:browser": "npm --workspace @stylisttg/dashboard run qa:browser",
    "qa:screenshots": "npm --workspace @stylisttg/dashboard run qa:screenshots",
    "dashboard:dev": "npm --workspace @stylisttg/dashboard run dev",
    "dashboard:build": "npm --workspace @stylisttg/dashboard run build",
    "memory:check": "mex check",
    "memory:check:quiet": "mex check --quiet",
    "memory:sync": "mex sync",
    "memory:sync:dry-run": "mex sync --dry-run",
    "memory:commands": "mex commands"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "openapi-typescript": "^7.10.1",
    "promexeus": "^0.3.4",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "@vitest/coverage-v8": "4.1.6"
  }
}
