# StylistTG dev/staging cloud environment contract.
# Copy to an ignored local file such as .env.cloud.local and fill with dev/staging secrets.
# Never commit real credentials.

## App mode
APP_ENV=staging
AUTH_MODE=supabase_jwt
DB_CONNECTION_MODE=neon
ALLOW_LOCAL_AUTH_IN_PROD=false

## Neon Postgres
# Runtime/API/workers use the pooled URL. Migrations/admin use the direct URL.
# Do not run Alembic migrations through the pooled URL.
DATABASE_RUNTIME_URL=postgresql+psycopg://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_DIRECT_URL=postgresql+psycopg://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=${DATABASE_RUNTIME_URL}
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

## Supabase Auth
# Supabase is the identity provider only. FastAPI enforces tenant/role access.
SUPABASE_AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUTH_ISSUER=https://<project>.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
SUPABASE_AUTH_JWKS_CACHE_TTL_SECONDS=600
SUPABASE_AUTH_JWKS_REFRESH_ON_KID_MISS=true
SUPABASE_AUTH_JWKS_REQUEST_TIMEOUT_SECONDS=5
SUPABASE_AUTH_JWKS_MAX_RETRIES=1

## Object storage
STORAGE_BACKEND=s3
STORAGE_S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
STORAGE_S3_BUCKET=stylisttg-dev-assets-pnn2026
STORAGE_S3_REGION=eu-central-003
STORAGE_S3_ACCESS_KEY_ID=<b2-key-id>
STORAGE_S3_SECRET_ACCESS_KEY=<b2-application-key>
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_SIGNED_URL_EXPIRES_SECONDS=300
STORAGE_S3_PUBLIC_BASE_URL=

## Redis
REDIS_URL=rediss://<user>:<password>@<host>:<port>/0

## TDLib
# Keep mock mode for staging deploy/cloud smoke. Use tdlib only in a separate reviewed live runtime.
# TDLib sessions are backend-only runtime data, not object-storage assets.
TDLIB_SHARED_LIBRARY_PATH=
TDLIB_DATABASE_ROOT=/var/lib/stylisttg/tdlib/database
TDLIB_FILES_ROOT=/var/lib/stylisttg/tdlib/files
TDLIB_STORAGE_BACKEND=local
PROFILE_EXECUTION_ADAPTER=mock
TDLIB_LIVE_ENABLED=false
STALE_JOB_REAPER_ENABLED=false

## Account lifecycle, audit, and production execution plane
ACCOUNT_EXPORT_TTL_DAYS=7
ACCOUNT_DELETION_LOG_RETENTION_DAYS=90
ACCOUNT_DELETION_ALLOW_HARD_DELETE=false
ACCOUNT_DELETION_DRY_RUN_DEFAULT=true
SCHEDULER_ENABLED=false
REAPER_ENABLED=false
REAPER_MODE=dry_run
RATE_LIMIT_AUTH_JOBS_PER_TENANT_PER_HOUR=20
RATE_LIMIT_PROFILE_JOBS_PER_TENANT_PER_HOUR=100
RATE_LIMIT_MEDIA_JOBS_PER_TENANT_PER_HOUR=50
RATE_LIMIT_STORY_JOBS_PER_TENANT_PER_HOUR=20
RATE_LIMIT_ACCOUNT_JOBS_PER_HOUR=10

## Dashboard
# Frontend build must not contain service-role keys or backend-only secrets.
VITE_API_BASE_URL=https://<staging-api-host>
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
VITE_APP_ENV=staging
